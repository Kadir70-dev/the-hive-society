# Public site URL used for SEO metadata (Open Graph, sitemap, robots).
# Set this to the production domain when deploying; falls back to localhost in development.
NEXT_PUBLIC_SITE_URL=https://thehivesociety.ae

# Supabase project (Project Settings -> API in the Supabase dashboard).
# NEXT_PUBLIC_* values are safe to expose in the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — server-only. NEVER prefix with NEXT_PUBLIC_, never commit
# a real value, never log it. Used only in server-only modules
# (src/lib/supabase/admin.ts) to insert/read/update community_applications
# and admin_users, bypassing Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=

# Ziina (UAE payments) — used for paid membership checkout.
# Generate at docs.ziina.com/developers/custom-integration. Server-only,
# never prefix with NEXT_PUBLIC_. See supabase/README.md "Memberships".
ZIINA_API_KEY=
# Set by supabase/scripts/register_ziina_webhook.mjs after you have an API key.
ZIINA_WEBHOOK_SECRET=
# "true" while testing (Ziina accepts any card, no real charge); "false" to go live.
ZIINA_TEST_MODE=true
